{
  "name": "qemu-ios-emulator",
  "version": "2.0.0",
  "description": "QEMU iOS Emulator - Visual iOS device emulator manager for Linux & Windows servers",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build && electron-builder",
    "start": "electron .",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.qemu.ios.emulator",
    "productName": "QEMU iOS Emulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "System"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "vite": "^5.0.0",
    "concurrently": "^8.2.2",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
