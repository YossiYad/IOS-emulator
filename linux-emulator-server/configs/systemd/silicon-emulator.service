[Unit]
Description=Silicon iOS Emulator Manager and Headless VM
After=network.target

[Service]
Type=simple
User=emulator_user
WorkingDirectory=/var/lib/qemu-ios-emulator
# Start a default headless VM via enhanced-run.sh
ExecStart=/bin/bash /workspaces/qemu-ios-emulator/linux-emulator-server/src/scripts/enhanced-run.sh --name default --headless
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
